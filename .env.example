# --- Zorunlu ---
TELEGRAM_BOT_TOKEN=            # @BotFather'dan
TELEGRAM_OWNER_ID=             # sahibin KULLANICI id'si (isteğe bağlı): botun kendi kanallarında bu id ile yazan kişi tam komut zincirini alır (/tani…); boşsa TELEGRAM_CHAT_ID pozitifse o
TELEGRAM_CHAT_ID=              # bota /id yaz, söylediği değeri gir

# --- Önerilen ---
DASHBOARD_TOKEN=               # dashboard'a ?key=BU_DEGER ile girilir (boş = herkese açık)
ADMIN_PASSWORD=                # ayar değiştirme + Telegram gönderme şifresi (boş bırakılırsa DASHBOARD_TOKEN kullanılır)
DB_PATH=/data/radar.db         # Railway Volume mount noktası
CRYPTO_CHAT_ID=                # kripto kanalı: hacim patlaması + liq yakını bildirimleri (boş = kripto bildirimleri GİTMEZ)
SIM_CHAT_ID=                   # liq simülasyonu kanalı: SİM açılış/kapanış/sıfırlama mesajları (boş = Telegram'a gitmez, /sim sayfası yine çalışır)

# --- Opsiyonel ---
FINNHUB_API_KEY=               # verilirse takvimde Yahoo'ya ek doğrulama + saat bilgisi
AI_API_KEY=                    # AI analist için (console.groq.com'dan bedava alınır; boşsa özellik kapalı)

# Aşağıdakilerin hepsi SADECE İLK VARSAYILANDIR — canlıda dashboard'daki
# ⚙️ /settings sayfasından değiştirilir (DB'de saklanır, deploy gerektirmez).
# İstersen buraya hiç girmeyebilirsin.
EQUITY_DEXES=xyz               # hisse perp'lerinin yaşadığı HIP-3 dex'leri (virgülle)
CRYPTO_DEXES=para              # HIP-3 kripto dex'leri (para:ANSEM): kripto sınıfı, veri hattı HIP-3 (süpürücü adres başına +1 istek)
CRYPTO_DEX_FILL_MIN_NOTIONAL=1000      # kripto dex (para) fill tabanı — memecoin'de $5K traderların çoğunu gizliyordu
CRYPTO_DEX_MIN_POSITION_NOTIONAL=1000  # kripto dex pozisyon toz filtresi (bildirim eşikleri değişmez)
MIN_FILL_NOTIONAL=5000         # bu boyut üstü fill'ler havuza yazılır ($)
WHALE_ALERT_NOTIONAL=5000000   # sicilsiz adresten bu boyut üstü tek işlemde anlık alert ($) — yalnız normal hisse
WHALE_ALERT_WATCH_NOTIONAL=250000  # sicilli (watchlist) balina kazandığı hisseye dönünce ($, her sınıf)
FRESH_WALLET_DAYS=7            # "taze cüzdan" eşiği (gün)
RECENT_DEPOSIT_HOURS=72        # "yeni fonlanmış hesap" eşiği (saat)
EVAL_MOVE_THRESHOLD=2.0        # earnings sonrası sicile işlemek için min hareket (%)
QUIET_START_HOUR=1             # sessiz saat başlangıcı (TSİ) — normal bildirimler beklemeye alınır
QUIET_END_HOUR=8               # sessiz saat bitişi
DIGEST_HOUR=9                  # sabah özeti saati (TSİ)
LEADERBOARD_TOP=500            # havuza tohumlanan leaderboard adresi sayısı
SCAN_MAX_CANDIDATES=600        # tek taramada sorgulanacak maksimum aday adres
CRYPTO_WATCH_TOP=120           # ana dex'te canlı dinlenen coin sayısı — hacimce ilk N (0 = kapalı). PUMP gibi coinler ancak listedeyse TWAP radarına girer; /twap PUMP söyler
PROBE_MIN_NOTIONAL=100000      # hisse tarafında bu boyut üstü işlemde adresin profiline HEMEN bak ($)
PROBE_MIN_NOTIONAL_CRYPTO=2000000  # aynısının kripto tarafındaki karşılığı ($)
HL_BIG_MIN_USD=1000000         # "HL'nin en büyükleri" kayıt eşiği — HIP-3 hisse/emtia ($)
HL_CRYPTO_MIN_USD=20000000     # aynı panelin kripto eşiği ($)
HL_MAJOR_MIN_USD=50000000      # BTC/ETH eşiği ($)
CRYPTO_VOL_ALERT_MIN_USD=1000000 # kripto 5dk hacim rekoru: bu tutarın altındaysa kanala düşmez (sayfa yine yazar)
EQUITY_VOL_ALERT_MIN_USD=1000000 # hisse 5dk hacim rekoru: aynı kural (eski $100K kanalı spam'e boğuyordu)
CRYPTO_LIQ_MIN_USD=500000      # kripto liq yakını: bu boyut üstü pozisyon (BTC/ETH hariç) …
CRYPTO_LIQ_SHOW_USD=200000     # /sembol GRAFİĞİ: bu boyut üstü her pozisyon kendi çizgisini alır (metin eşiği alarmla aynı)
CRYPTO_LIQ_LIST_DIST_PCT=20    # /sembol METNİ: bu mesafeden uzak pozisyon/band yazılmaz (mesaj tek parça kalsın; grafik hepsini çizer)
SPOT_WATCH_TOP=40              # hacimce ilk N spot çifti (@107 = PURR/USDC…) WS'te dinlenir — TWAP dilimleri için
SPOT_FILL_MIN_NOTIONAL=5000    # spot işlemi bu tutarın altındaysa fills'e yazılmaz (0 = spot kaydı kapalı)
CRYPTO_LIQ_DIST_PCT=2.5        # … likidasyona bu kadar yaklaşınca CRYPTO_CHAT_ID'ye mesaj
CRYPTO_LIQ_COOLDOWN=14400      # aynı pozisyon için yeniden bildirim aralığı (sn) — yalnız 1. kademe
CRYPTO_LIQ_DIST2_PCT=1.0       # 2. uyarı: liq'e bu kadar kala (beklemeye bakmaz)
CRYPTO_LIQ_DIST3_PCT=0.5       # son uyarı; sonrası likidasyon/kapanış notu
LIQ_ATTACK_ALERT_BIG_DIST_PCT=1      # liq attack, endeks/emtia/FX (SP500, XYZ100, GOLD…): kapı ≤ bu mesafe …
LIQ_ATTACK_ALERT_BIG_MIN_USD=50000000  # … içinde en az bu kadar liq yoksa mesaj yok (hisse: ≤%2 / $1M)
SWEEP_CATCHUP=1                # derin keşif artan istek bütçesini kullanıp hızlansın (0 = sabit parti)
SWEEP_BATCH_MAX=250            # yetişme modunda bir partideki en fazla adres
SWEEP_RPM_HEADROOM=0.85        # küresel istek bütçesinin en fazla bu oranı doldurulsun
HL_MAX_RPM=550                 # HL'ye giden TÜM isteklerin ortak tavanı (istek/dk; HL 1200 ağırlık/dk, clearinghouse ağırlık 2 → ~600)
HARVEST_PROBE_MAX=40           # hasat sondası: tur başına en fazla bu kadar yeni adresin defteri (coinin dex'inde, 1 istek/adres; 0 = kapalı)
CENSUS_ENABLED=1               # sayım: tanıdığımız HER hesabın defteri ana dex + kripto dex'lerde (para), bakiye sırasıyla, tur tur — kapsama (havuz/HL OI) bunun için yükselir
CENSUS_RPM=250                 # sayımın kendi hızı (istek/dk); HL 429 dönerse kendiliğinden yarıya iner; küresel HL bütçesi ayrıca uygulanır
CENSUS_MIN_ACCOUNT_VALUE=100   # leaderboard'da bakiyesi bunun altındaki hesaplar sayıma girmez (haftalık hacim şartı yok)
CENSUS_HIP3_MIN_ACCOUNT_VALUE=1000  # kripto dex (para) sorgusu yalnız bakiyesi bunun üstündeki hesaplarda (ana dex herkeste)
CENSUS_BATCH_SIZE=50           # toplu sorgu (batchClearinghouseStates) bir istekte kaç hesap; sonda tek tek moda düşerse etkisiz
CENSUS_RPM_LOCAL=100           # worker'lar kira alıyorken ana uygulamanın kendi sayım hızı (IP bütçesi paylaşımlı olabilir)
CENSUS_HOT_RPM=120             # sıcak şerit (az önce işlem yapan adresler) normal şeritten bu hızla; toplu tarama düşük şeritte
VOL_WS_PREFILTER=1             # kripto/hisse hacim: canlı akışta 10 dk'da sayfa tabanı kadar işlem görmeyen coine 5dk mum sorulmaz
LIQ_WATCH_ALL_DEXES=0          # 1 = liq radarı her hesapta 3 dex sorar (eski); 0 = HIP-3 dex'i yalnız pozisyonu/izi olan hesapta
# --- Sayım worker'ları (isteğe bağlı; Railway'de aynı repodan ek servisler) — env-only
ROLE=                          # census-worker → bu servis DB'siz worker olur (python -m app.worker); boş = ana uygulama
MAIN_URL=                      # worker için ana uygulamanın adresi (https://…railway.app); ana uygulamada boş
WORKER_TOKEN=                  # worker ↔ ana uygulama ortak sırrı (ikisinde de aynı); boşsa /api/census/* uçları yok (404)
WORKER_LEASE_N=500             # worker bir kirada kaç hesap alsın (10 dk kira; tek tek modda 250/dk ≈ 2 dk)
WORKER_NAME=                   # /tani'da görünen ad (boşsa Railway replica id / hostname)
BIG_ALERT_INDEX_USD=0          # XYZ100/SP500/GOLD gibi endeks-emtiada 'yeni büyük poz' bildirimi (0 = yok)
BIG_ALERT_MAJOR_USD=0          # hacimce ilk N hissede (NVDA…) bildirim (0 = yok — kullanıcı kuralı)
BIG_ALERT_MIN_USD=8000000      # normal hisselerde 'yeni büyük pozisyon' bildirim tabanı ($)
ANOMALY_OI_DELTA_MIN_USD=5000000   # OI birikimi bildirimi: 24 saatte OI en az bu kadar $ büyümeli (hacim tetiği yok)
ANOMALY_OI_DELTA_EVENT_USD=2500000 # earnings ≤72 sa iken aynı kural (4 saatlik dal da açık)
TRACK_AUTO_STOP=0              # 1 = takip süre dolunca poz açık olsa bile bitsin (eski davranış)
TRACK_LIQ_STEP_PCT=1           # takipteki pozun liq fiyatı son bildirilene göre %1 kayınca haber (0 = kapalı)
AI_ENABLED=0                   # 1 = AI analist çalışsın (AI_API_KEY de gerekir)
AI_INTERVAL_SEC=7200           # tur aralığı — 2 saat, Groq bedava katmanında ~48K token/gün
AI_DAILY_TOKEN_CAP=180000      # günlük token tavanı (Groq bedava gpt-oss-120b sınırı 200K)
AI_MAX_HYPOTHESES=3            # tur başına en fazla hipotez
AI_MODEL=openai/gpt-oss-120b   # model adları sağlayıcıda değişir; yanlışsa /ai hata metni doğrusunu listeler
AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# --- Satılabilir bot (herkese açık DM akışı) — varsayılan KAPALI
PUBLIC_BOT_ENABLED=0           # 1 = bota özelden yazan herkes kaydolur, coin sorgular, Pro olabilir
FREE_DAILY_QUERIES=3           # ücretsiz kullanıcı günde bu kadar coin sorgusu (TSİ 00:00 yenilenir)
PRO_PRICE_USD_1M=2.99          # Pro 1 ay ($); 3 ay PRO_PRICE_USD_3M=7.99, 12 ay PRO_PRICE_USD_12M=24.99 (0 = satılmaz)
STARS_PER_USD=77               # Telegram Stars kuru: $2.99 → 230 Stars (komisyon kullanıcıda)
QUERY_GLOBAL_PER_MIN=40        # tüm kullanıcıların HL'ye giden sorgu tavanı (≈120 HL isteği/dk)
PAY_HL_ADDRESS=                # USDC ödemelerinin geleceği HL adresi (önce bir kez yatırım yapıp aktive et)
NOWPAYMENTS_API_KEY=           # kripto ağ geçidi (boşsa menüde görünmez)
NOWPAYMENTS_IPN_SECRET=        # NOWPayments IPN imza anahtarı
SUPPORT_CONTACT=               # mesajlarda gösterilen destek adresi, ör. @kullanici

PUBLIC_BASE_URL=               # NOWPayments IPN geri çağrısı için kamuya açık taban URL (boşsa RAILWAY_PUBLIC_DOMAIN)
BOT_USERNAME=                  # /bot tanıtım sayfasındaki Telegram linki (boşsa getMe'den alınır)
