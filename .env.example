AI_DAILY_TOKEN_CAP=180000      # günlük token tavanı (Groq bedava gpt-oss-120b sınırı 200K)
AI_MAX_HYPOTHESES=3            # tur başına en fazla hipotez
AI_MODEL=openai/gpt-oss-120b   # model adları sağlayıcıda değişir; yanlışsa /ai hata metni doğrusunu listeler
AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# --- Satılabilir bot (herkese açık DM akışı) — varsayılan KAPALI
PUBLIC_BOT_ENABLED=0           # 1 = bota özelden yazan herkes kaydolur, coin sorgular, Pro olabilir
FREE_DAILY_QUERIES=3           # ücretsiz kullanıcı günde bu kadar coin sorgusu (TSİ 00:00 yenilenir)
PRO_PRICE_USD_1M=2.99          # Pro 1 ay ($); 3 ay PRO_PRICE_USD_3M=7.99, 12 ay PRO_PRICE_USD_12M=24.99 (0 = satılmaz)
STARS_PER_USD=77               # Telegram Stars kuru: $2.99 → 230 Stars (komisyon kullanıcıda)
QUERY_GLOBAL_PER_MIN=40        # tüm kullanıcıların HL'ye giden sorgu tavanı (≈120 HL isteği/dk)
PAY_HL_ADDRESS=                # USDC ödemelerinin geleceği HL adresi (önce bir kez yatırım yapıp aktive et)
NOWPAYMENTS_API_KEY=           # kripto ağ geçidi (boşsa menüde görünmez)
NOWPAYMENTS_IPN_SECRET=        # NOWPayments IPN imza anahtarı
SUPPORT_CONTACT=               # mesajlarda gösterilen destek adresi, ör. @kullanici

PUBLIC_BASE_URL=               # NOWPayments IPN geri çağrısı için kamuya açık taban URL (boşsa RAILWAY_PUBLIC_DOMAIN)
BOT_USERNAME=                  # /bot tanıtım sayfasındaki Telegram linki (boşsa getMe'den alınır)
