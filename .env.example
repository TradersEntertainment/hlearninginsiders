LAB_ENABLED=1                  # 🧪 strateji laboratuvarı: karar anı kaydı + kâğıt üstü ölçüm (mesaj yalnız onaylı kuraldan, ARAMA YOK)
LAB_ALPHA=0.05                 # laboratuvar geneli yanlış keşif payı (tek yönlü) — yalnız env, kayıtta kurala donar
LAB_K_BUDGET=10                # önceden ilan edilen kural yuvası sayısı; kural başına α = LAB_ALPHA / K (0.005)
LAB_EPOCH=2                    # dönem 2 (08.10): 10 kural. α/K dönemin ilk kaydında donar; değiştirmek = yeni dönem
LAB_WEIGHT_MIN=240             # lab'ın dakikalık HL ağırlık tavanı (çözücü önce, geri doldurma artanla)
STRAT_CHAT_ID=                 # 🧪 onaylı kural mesajları + onay soruları (boşsa ana sohbet; yalnız sahip, arama yok)
WAKE_TELEGRAM_USER=            # 🚨 /alarm: seni Telegram'dan arayacak hesap (@kullanıcıadı ya da +90…) — @CallMeBot_txtbot'a /start yaz
WAKE_CALL_ROUNDS=3             # onay gelmezse en çok tur (her tur 2 arama, ~70 sn arayla)
WAKE_ALARM_HOURS=18            # kurulan alarm bu kadar saat sonra kendiliğinden kalkar
OPEN_MOVERS_TOP=10             # 🔔 açılışın en hareketlileri: 5 dk ve 30 dk raporunda kaç hisse (hisse kanalı)
OPEN_MOVERS_MIN_USD=25000      # pencerede hacmi bunun altında kalan hisse sıralamaya girmez (tek işlemlik oynama)
MOVE_WINDOW_MIN_USD=10000      # ⏱ /5dk · /15dk: 5 dk başına sıralama tabanı (süreyle ölçeklenir: 15 dk → $30K)
