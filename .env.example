ACCT_MIN_POS_USD=100000        # bunun altındaki yeni pozisyon "açtı" sayılmaz
SLICE_WATCH_LIST=0x30afce2f6842bf183c7e3fe7162e279ff0b6393e:CBRS   # 🔂 adres:SEMBOL[:isim] — TWAP emri olmadan dilimli alım-satım (hesap grubuna)
SLICE_POLL_SEC=30              # adres başına dolum yoklaması (tek istek tüm coinleri getirir)
SLICE_QUIET_SEC=300            # aynı yönde bu kadar sn dilim gelmezse "bitti" (ölçülen en uzun ara 50 sn)
SLICE_START_ORDERS=3           # "başladı" için aynı yönde en az emir …
SLICE_START_USD=10000          # … ve en az $
SEANS_COINS=XYZ100,SP500       # 🕰 /seans sekmeleri (ABD'de işlem gören hisse/endeks perp'leri, dex'siz)
SEANS_REFRESH_SEC=3600         # seans karnesi mum arşivi turu (en az 600; sembol başına tek istek)
SEANS_ARCHIVE_ALL=1            # 🧪 PROPR'daki ABD hisselerinin 30 dk mumlarını da arşivle (sekmelerden ayrı)
PROPR_LIVE=1                   # ✅ PROPR listesine propr.xyz'nin YENİ listelediklerini sessizce ekle (hiçbir şey çıkarılmaz; 0 = yalnız koddaki liste)
PROPR_SYNC_SEC=3600            # PROPR listesi okuma aralığı (en az 600)
