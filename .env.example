# --- Zorunlu ---
TELEGRAM_BOT_TOKEN=            # @BotFather'dan
TELEGRAM_CHAT_ID=              # bota /id yaz, söylediği değeri gir

# --- Önerilen ---
DASHBOARD_TOKEN=               # dashboard'a ?key=BU_DEGER ile girilir (boş = herkese açık)
ADMIN_PASSWORD=                # ayar değiştirme + Telegram gönderme şifresi (boş bırakılırsa DASHBOARD_TOKEN kullanılır)
DB_PATH=/data/radar.db         # Railway Volume mount noktası

# --- Opsiyonel ---
FINNHUB_API_KEY=               # verilirse takvimde Yahoo'ya ek doğrulama + saat bilgisi
AI_API_KEY=                    # AI analist için (console.groq.com'dan bedava alınır; boşsa özellik kapalı)

# Aşağıdakilerin hepsi SADECE İLK VARSAYILANDIR — canlıda dashboard'daki
# ⚙️ /settings sayfasından değiştirilir (DB'de saklanır, deploy gerektirmez).
# İstersen buraya hiç girmeyebilirsin.
EQUITY_DEXES=xyz               # hisse perp'lerinin yaşadığı HIP-3 dex'leri (virgülle)
MIN_FILL_NOTIONAL=5000         # bu boyut üstü fill'ler havuza yazılır ($)
WHALE_ALERT_NOTIONAL=250000    # bu boyut üstü işlemde anlık Telegram alert ($)
FRESH_WALLET_DAYS=7            # "taze cüzdan" eşiği (gün)
RECENT_DEPOSIT_HOURS=72        # "yeni fonlanmış hesap" eşiği (saat)
EVAL_MOVE_THRESHOLD=2.0        # earnings sonrası sicile işlemek için min hareket (%)
QUIET_START_HOUR=1             # sessiz saat başlangıcı (TSİ) — normal bildirimler beklemeye alınır
QUIET_END_HOUR=8               # sessiz saat bitişi
DIGEST_HOUR=9                  # sabah özeti saati (TSİ)
LEADERBOARD_TOP=500            # havuza tohumlanan leaderboard adresi sayısı
SCAN_MAX_CANDIDATES=600        # tek taramada sorgulanacak maksimum aday adres
CRYPTO_WATCH_TOP=30            # ana dex'te canlı dinlenen coin sayısı (0 = kripto dinleme kapalı)
PROBE_MIN_NOTIONAL=100000      # hisse tarafında bu boyut üstü işlemde adresin profiline HEMEN bak ($)
PROBE_MIN_NOTIONAL_CRYPTO=2000000  # aynısının kripto tarafındaki karşılığı ($)
HL_BIG_MIN_USD=1000000         # "HL'nin en büyükleri" kayıt eşiği — HIP-3 hisse/emtia ($)
HL_CRYPTO_MIN_USD=20000000     # aynı panelin kripto eşiği ($)
HL_MAJOR_MIN_USD=50000000      # BTC/ETH eşiği ($)
SWEEP_CATCHUP=1                # derin keşif artan istek bütçesini kullanıp hızlansın (0 = sabit parti)
SWEEP_BATCH_MAX=250            # yetişme modunda bir partideki en fazla adres
SWEEP_RPM_HEADROOM=0.85        # küresel istek bütçesinin en fazla bu oranı doldurulsun
BIG_ALERT_INDEX_USD=10000000   # XYZ100/SP500/GOLD gibi endeks-emtiada bildirim tabanı ($)
BIG_ALERT_MAJOR_USD=5000000    # hacimce ilk N hissede (NVDA…) bildirim tabanı ($)
BIG_ALERT_MIN_USD=1000000      # küçük/orta hisselerde bildirim tabanı ($)
TRACK_AUTO_STOP=0              # 1 = takip süre dolunca poz açık olsa bile bitsin (eski davranış)
AI_ENABLED=0                   # 1 = AI analist çalışsın (AI_API_KEY de gerekir)
AI_INTERVAL_SEC=7200           # tur aralığı — 2 saat, Groq bedava katmanında ~48K token/gün
AI_DAILY_TOKEN_CAP=180000      # günlük token tavanı (Groq bedava gpt-oss-120b sınırı 200K)
AI_MAX_HYPOTHESES=3            # tur başına en fazla hipotez
AI_MODEL=openai/gpt-oss-120b   # model adları sağlayıcıda değişir; yanlışsa /ai hata metni doğrusunu listeler
AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
